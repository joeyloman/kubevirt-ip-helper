# Pinned dependency configuration for the disposable kubevirt-ip-helper E2E
# cluster. This file is sourced by test/e2e/bootstrap.sh, test/e2e/run.sh and
# test/e2e/collect.sh, so it only holds plain variable assignments: bash and
# POSIX sh can both source it. Every version, URL, checksum and name used by the
# E2E scripts lives here.
#
# Downloads are verified against the SHA256 values below, so bumping a version
# requires bumping its digest in the same commit.

# ---- Profile selection --------------------------------------------------
# E2E_STACK selects one of two pinned dependency sets:
#   current         the default lane, and the production-compatibility signal:
#                   the newest kind, Kubernetes and KubeVirt the helper is
#                   expected to work on today.
#   dependency-era  the older lane the suite was first built on, kept pinned so
#                   its result stays attributable to that dependency set.
# Nothing else is accepted, and the check runs while this file is sourced, so a
# typo cannot reach a cluster.
# E2E_GROUP selects which part of the suite runs:
#   all        core lifecycle first, then every expanded group (default)
#   core       the stacked core lifecycle on its own
#   pool       exhaustion, duplicate MAC, CR reclaim, invalid request
#   lease      observed live-guest DHCP activity under a short lease
#   ha         follower churn, simultaneous replica delete, scaling, link flap
#   multipool  a second bridge, interface, pool, and isolated reservation
# Invalid groups are rejected while this file is sourced, before cluster
# creation, reuse, or mutation.
E2E_GROUP="${E2E_GROUP:-all}"
case "${E2E_GROUP}" in
  all | core | pool | lease | ha | multipool) ;;
  *)
    printf '[versions.env] ERROR: E2E_GROUP must be one of all, core, pool, lease, ha, multipool; got "%s"\n' \
      "${E2E_GROUP}" >&2
    exit 1
    ;;
esac
E2E_STACK="${E2E_STACK:-current}"
case "${E2E_STACK}" in
  current | dependency-era) ;;
  *)
    printf '[versions.env] ERROR: E2E_STACK must be current or dependency-era, got "%s"\n' \
      "${E2E_STACK}" >&2
    exit 1
    ;;
esac

# ---- Shared environment --------------------------------------------------
# These may be overridden from the environment before sourcing. Cluster, cache
# and artifact names carry the profile so the two lanes can never share a
# cluster, a cached binary, or a set of diagnostics.
# Each group gets its own cluster, cache, and artifact namespace unless it runs
# as `all`, so a per-group job can never collide with another group's retained
# cluster, cached binaries, or diagnostics on a shared runner.
case "${E2E_GROUP}" in
  all) E2E_NAME_SUFFIX="${E2E_STACK}" ;;
  *) E2E_NAME_SUFFIX="${E2E_STACK}-${E2E_GROUP}" ;;
esac
E2E_CLUSTER_NAME="${E2E_CLUSTER_NAME:-kubevirt-ip-helper-e2e-${E2E_NAME_SUFFIX}}"
E2E_IMAGE="${E2E_IMAGE:-kubevirt-ip-helper:e2e-${E2E_NAME_SUFFIX}}"
E2E_KEEP_CLUSTER="${E2E_KEEP_CLUSTER:-}"

# Generated assets (kind binary, virtctl, downloaded manifests, CNI bundle) are
# cached outside the repository so the working tree stays clean.
E2E_CACHE_DIR="${E2E_CACHE_DIR:-${XDG_CACHE_HOME:-$HOME/.cache}/kubevirt-ip-helper-e2e/${E2E_NAME_SUFFIX}}"
E2E_BIN_DIR="${E2E_BIN_DIR:-${E2E_CACHE_DIR}/bin}"
VIRTCTL="${E2E_BIN_DIR}/virtctl"

# Diagnostics collected by test/e2e/collect.sh, relative to the repository root.
E2E_ARTIFACTS_DIR="${E2E_ARTIFACTS_DIR:-_artifacts/e2e/${E2E_NAME_SUFFIX}}"

# ---- Guest image ---------------------------------------------------------
# manifests/vm.yaml is the current-profile template and carries exactly
# ${KIH_GUEST_IMAGE_TEMPLATE}. run.sh renders the template into
# ${E2E_ARTIFACTS_DIR}, substitutes ${KIH_GUEST_IMAGE}, and applies that render,
# so a dependency-era run can never start the guest on the current image.
KIH_GUEST_IMAGE_TEMPLATE="quay.io/kubevirt/cirros-container-disk-demo:v1.9.0@sha256:ebdb8d8b9b480f6ee7664ed3fdde8428767664f507d98f94090edeff04d7ebf2"

# Each profile pins its own versions and checksums. Individual pins are
# deliberately not environment-overridable: CI selects only E2E_STACK, keeping
# each lane an exact reproducible contract.
case "${E2E_STACK}" in
  current)
    # ---- kind ---------------
    KIND_VERSION="v0.33.0"
    KIND_SHA256_LINUX_AMD64="aee6151561422756b764a4ae28e7f44cda5af5a9eead3cc9985112b1de8d8e0d"

    KINDEST_NODE_IMAGE="kindest/node:v1.36.4@sha256:099e049362a1526b2db71494e1947aae99bd16290d7c895f2b7ea312e3cbfaed"
    KUBERNETES_VERSION="v1.36.4"

    # ---- KubeVirt -----------
    KUBEVIRT_VERSION="v1.9.0"
    KUBEVIRT_OPERATOR_SHA256="f11307caafc3c23ffedf9887d8beb5a4419e2694da242fa68f63d1ec820de2e0"
    VIRTCTL_SHA256_LINUX_AMD64="40ede2ee37c98a1aeed71c9c219616a05247ce2be109e1edddf0477572e8b978"
    KIH_GUEST_IMAGE="${KIH_GUEST_IMAGE_TEMPLATE}"
    ;;

  dependency-era)
    # ---- kind ---------------
    KIND_VERSION="v0.20.0"
    KIND_SHA256_LINUX_AMD64="513a7213d6d3332dd9ef27c24dab35e5ef10a04fa27274fe1c14d8a246493ded"

    KINDEST_NODE_IMAGE="kindest/node:v1.24.15@sha256:7db4f8bea3e14b82d12e044e25e34bd53754b7f2b0e9d56df21774e6f66a70ab"
    KUBERNETES_VERSION="v1.24.15"

    # ---- KubeVirt -----------
    KUBEVIRT_VERSION="v0.54.0"
    KUBEVIRT_OPERATOR_SHA256="b731e17f6d07bcc3bb02b7f68031f17040f4c9399164d082ee1bacd8cda754a4"
    VIRTCTL_SHA256_LINUX_AMD64="a46bf15c4213520c0f969554e87c44e1f277214b1a7e4a460ec39ed72fc65164"
    KIH_GUEST_IMAGE="quay.io/kubevirt/cirros-container-disk-demo:v0.54.0@sha256:00d08fb2f4f3dfc36b43fec4bc8d2d6fd71712377d029dc9927adf7e78ce80ec"
    ;;
esac

# Release URLs follow their selected versions, so a profile bump cannot leave a
# downloader pointed at the previous release.
KIND_BASE_URL="https://github.com/kubernetes-sigs/kind/releases/download/${KIND_VERSION}"

# The operator manifest and the virtctl binary are served under the KubeVirt
# release tag of the selected profile, so both URLs follow ${KUBEVIRT_VERSION}.
KUBEVIRT_OPERATOR_URL="https://github.com/kubevirt/kubevirt/releases/download/${KUBEVIRT_VERSION}/kubevirt-operator.yaml"
VIRTCTL_BASE_URL="https://github.com/kubevirt/kubevirt/releases/download/${KUBEVIRT_VERSION}"
# The namespace and CR name are identical in both profiles. bootstrap.sh generates
# the KubeVirt CR instead of applying the upstream kubevirt-cr.yaml of the selected
# release, so software emulation is set on the very first reconcile.
KUBEVIRT_NAMESPACE="kubevirt"
KUBEVIRT_CR_NAME="kubevirt"

# ---- CNI plugins (bridge plugin for every kind node) ---------------------
CNI_PLUGINS_VERSION="v1.9.1"
CNI_PLUGINS_BASE_URL="https://github.com/containernetworking/plugins/releases/download/v1.9.1"
CNI_PLUGINS_SHA256_LINUX_AMD64="b98f74a0f8522f0a83867178729c1aa70f2158f90c45a2ca8fa791db1c76b303"

# ---- Multus (thick plugin, chained on top of the kindnet delegate) -------
MULTUS_VERSION="v4.3.0"
MULTUS_MANIFEST_URL="https://raw.githubusercontent.com/k8snetworkplumbingwg/multus-cni/v4.3.0/deployments/multus-daemonset-thick.yml"
MULTUS_MANIFEST_SHA256="2d622f697809644a12704497bbf5c3256adc1e7f5b5504655e4993743651b585"
MULTUS_DAEMONSET="kube-multus-ds"
MULTUS_NAMESPACE="kube-system"
# The upstream v4.3.0 manifest points its images at the moving "snapshot-thick"
# tag; bootstrap.sh rewrites them to the digest-pinned ${MULTUS_IMAGE}.
MULTUS_MANIFEST_TAG="snapshot-thick"
MULTUS_IMAGE_REPO="ghcr.io/k8snetworkplumbingwg/multus-cni"
MULTUS_IMAGE_TAG="v4.3.0-thick"
MULTUS_IMAGE_DIGEST="sha256:a922a39a78049991d03178c07afc45a198326481049bd7d84626097402fa14bb"
MULTUS_IMAGE="${MULTUS_IMAGE_REPO}:${MULTUS_IMAGE_TAG}@${MULTUS_IMAGE_DIGEST}"

# ---- CNI chain preflight -------------------------------------------------
# Minimal digest-pinned image for the plain/NAD probe pods. A Ready probe
# proves the CNI chain works before the expensive KubeVirt installation.
PROBE_IMAGE="registry.k8s.io/pause:3.10@sha256:ee6521f290b2168b6e0935a181d4cff9be1ac3f505666ef0e3c98fae8199917a"

# ---- Contracted names and IP pool ----------------------------------------
# Helper namespace, workload namespace, NAD, bridge and helper interface names
# are fixed for the whole suite: manifests, bootstrap.sh and run.sh all refer to
# exactly these strings.
KIH_HELPER_NAMESPACE="kubevirt-ip-helper"
KIH_WORKLOAD_NAMESPACE="e2e"
KIH_NAD_NAME="kubevirt-ip-helper-e2e"
KIH_BRIDGE_NAME="br-kih-e2e"
KIH_HELPER_INTERFACE="kihnet0"
KIH_PLAIN_PROBE_POD="kih-plain-probe"
KIH_NAD_PROBE_POD="kih-nad-probe"

KIH_IPPOOL_NAME="e2e-pool"
KIH_IPPOOL_SUBNET="10.77.0.0/24"
KIH_IPPOOL_SERVER="10.77.0.2"
KIH_IPPOOL_START="10.77.0.100"
KIH_IPPOOL_END="10.77.0.110"
KIH_IPPOOL_ROUTER="10.77.0.1"
KIH_VM_NAME="e2e-vm"
KIH_VM_MAC="02:00:00:00:00:11"

# Marker the guest console must print once the helper answered DHCP. run.sh
# parses this exact prefix and collect.sh greps for it in the saved console log.
E2E_DHCP_MARKER="E2E_DHCP_OK"

# ---- Timeouts ------------------------------------------------------------
# Seconds allowed for each rollout/probe wait. Every wait is a hard assertion.
E2E_WAIT_TIMEOUT="300"
E2E_PROBE_TIMEOUT="120"
# The reload boot acquires a 600-second lease. Failover gets at most 540 seconds,
# but its absolute deadline is also capped by the lease window started before
# that boot, so stop latency cannot move the assertion past lease expiry.
E2E_RETAINED_LEASE_SECONDS="600"
E2E_FAILOVER_DHCP_TIMEOUT="540"
# Diagnostics are best effort: bound each command and the entire EXIT-trap run
# so an unresponsive API server or runtime cannot hide the original result.
E2E_CAPTURE_TIMEOUT="20"
E2E_COLLECT_TOTAL_TIMEOUT="180"
